# ========= SAFETY (fail-closed defaults) =========
TRADING_MODE=DEMO
LIVE_TRADING=false
AUTO_STRATEGY_DEPLOY=false
AUTO_RISK_CHANGE=false

# ========= MT5 =========
# MCP = talk to an MT5 MCP bridge; SIMULATOR = built-in simulated broker (dev/tests)
MT5_MODE=MCP
# Spawn command for the MT5 MCP server (stdio), e.g.:
#   npx -y @mcp/mt5-bridge
MT5_MCP_COMMAND=
# Or HTTP endpoint of a running MT5 MCP server
MT5_SERVER_HOST=127.0.0.1
MT5_SERVER_PORT=8765

# ========= Trading loop =========
SYMBOLS=XAUUSD
LOOP_INTERVAL_SECONDS=15

# ========= API =========
API_PORT=8000
AUTH_DISABLED=false          # true ONLY for local dev
FIREBASE_PROJECT_ID=your-project-id

# ========= Telegram =========
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========= AI Model Router (OpenRouter-compatible) =========
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Optional per-category overrides (else cheap/strong defaults are used)
MODEL_MARKET_CLASSIFICATION=
MODEL_STRATEGY_EVALUATION=
MODEL_TRADE_DECISION=
MODEL_TRADE_ANALYSIS=
MODEL_STATISTICS=
MODEL_RESEARCH=
MODEL_BACKTESTING_ANALYSIS=
MODEL_STRATEGY_GENERATION=
MODEL_CODING=
MODEL_CHAT=

# ========= Risk limits (env-only; the AI can NEVER change these) =========
RISK_MAX_LOT=0.10
RISK_MAX_RISK_PERCENT=1.0
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_DAILY_LOSS_PERCENT=3.0
RISK_MAX_DRAWDOWN_PERCENT=10.0
RISK_MAX_SPREAD_POINTS=50
RISK_STOP_LOSS_REQUIRED=true
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_ALLOWED_SESSIONS=SYDNEY,TOKYO,LONDON,NEWYORK

# ========= Storage =========
DB_PATH=data/trading.db
FIRESTORE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# ===== AI_MT5 Trading Core — Windows VPS environment =====
# คัดลอกไฟล์นี้เป็น backend\.env แล้วแก้ค่าก่อนรัน setup-windows-vps.ps1

# ---- Safety (ห้ามแก้เอง จนกว่าจะผ่านเกณฑ์ DEMO ตามคู่มือ) ----
TRADING_MODE=DEMO
LIVE_TRADING=false
AUTONOMOUS_MODE=true
MT5_MODE=MCP

# ---- Symbols / Strategy V1 ----
SYMBOLS=XAUUSD
STRATEGY_TIMEFRAME=M15
STOCH_K_PERIOD=24
STOCH_D_PERIOD=24
STOCH_SLOWING=10

# ---- Risk limits (AI แก้ไม่ได้) ----
RISK_MAX_LOT=0.10
RISK_MAX_RISK_PERCENT=1.0
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_DAILY_LOSS_PERCENT=3.0
RISK_MAX_DRAWDOWN_PERCENT=10.0
RISK_MAX_SPREAD_POINTS=50
RISK_STOP_LOSS_REQUIRED=true

# ---- API (reverse proxy อยู่หน้างาน) ----
API_HOST=127.0.0.1
API_PORT=8000
AUTH_DISABLED=false
API_CORS_ORIGINS=https://my-first-project-24042.web.app,https://my-first-project-24042.firebaseapp.com,http://localhost:5173

# ---- Firebase (mirror + token verification) ----
FIREBASE_PROJECT_ID=my-first-project-24042
FIRESTORE_ENABLED=true
FIRESTORE_DATABASE_ID=ai-mt5-default
GOOGLE_APPLICATION_CREDENTIALS=ai-mt5-backend-key.json

# ---- Telegram (ใส่เมื่อมีบอท — ยังไม่มีก็ปล่อยว่างได้) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- AI / LLM (ถ้ามี OpenRouter key; ไม่มีระบบใช้ deterministic path) ----
LLM_API_KEY=
MODEL_CHART_ANALYSIS=
MODEL_TRADE_JOURNAL=
